# Einfacht.env —— 本仓事实系统配置
#
# ⚠️ 本仓是 GitHub **profile 仓**（README 直接显示在主页），不是软件项目。
# 所以台账量的是「主页资产的完整性」，不是代码规模。
export REFLECT_FACTS="FACTS.json"
export REFLECT_DOC="STATE.md"
export REFLECT_DOCS="STATE.md,README.md"
export REFLECT_QUESTIONS="questions"
export REFLECT_RETRACTIONS="retractions.json"
# 不变量闸门不启用（整行注释；空值会让 check_envfile 报「空不是通过」）
# export REFLECT_INVARIANTS="invariants.json"
# 单条目清单：本仓只有一份 README（GitHub profile 门面），没有多语言版本。
# 按 check_readme_sync 的文档，单条目 ⇒ 互链判据**自动退化**（只有一份语言时
# 「必须指全全部语言」自动成立），存在/非空判据照常。
# 不设这个旋钮会回落默认的三语名单（README.md/.zh.md/.de.md）并报「缺两份」。
export REFLECT_READMES="README.md"
export REFLECT_MEASURE_MODULE="measure_profile"
